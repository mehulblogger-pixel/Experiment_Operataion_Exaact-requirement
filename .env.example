# Copy to `.env` and adjust. All values are optional in development.

# --- Core ---
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=generate-a-long-random-string-for-production
# DJANGO_ALLOWED_HOSTS=ops.example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ops.example.com
# DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database (leave unset to use zero-config SQLite) ---
# POSTGRES_DB=inspexops
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Email (leave unset to print emails to the console) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=ops@example.com
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=operations@example.com

# --- Business rules (escalation thresholds, requirement 5ii) ---
# ESCALATION_TO_BRANCH_MANAGER_DAYS=3
# ESCALATION_TO_SBU_HEAD_DAYS=5
