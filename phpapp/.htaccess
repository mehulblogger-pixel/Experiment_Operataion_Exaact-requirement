# Route all requests (except real files/folders) to index.php
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Service worker: must be served from the root scope and never cached stale,
# otherwise field devices keep an old copy after an upgrade.
<FilesMatch "^sw\.js$">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, max-age=0"
    </IfModule>
</FilesMatch>

# Protect config and data
<FilesMatch "^(config\.php)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteRule ^data/ - [F]
</IfModule>

# --- Nothing below changes how the app works. It only closes doors that are
#     open by default on a shared host. ---

# Never list the contents of a folder that has no index page.
Options -Indexes

# Dotfiles: .htaccess itself, .git, editor leftovers. None of these should ever
# be fetchable, and a copy of .git would hand over the whole source history.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.git(/|$) - [F]
</IfModule>

# Files that are part of the build, not the site. A database left in the folder
# during a test, a backup an editor wrote, notes, the seed data.
<FilesMatch "\.(sqlite|sqlite3|db|sql|bak|old|orig|save|swp|log|ini|md|json|lock|yml|yaml)$">
    Require all denied
</FilesMatch>

# The program itself. With the rewrite above these are never requested directly,
# but if the rewrite is ever switched off this is what stops the source being
# read line by line — including whatever a future version keeps in it.
<IfModule mod_rewrite.c>
    RewriteRule ^(lib|views|tools|docs)/ - [F]
</IfModule>

# Do not advertise the PHP version in every response.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# --- HTTPS ---------------------------------------------------------------
# ON, because the certificate is now issued and working.
#
# Why this matters more than anything else in this file: on a plain HTTP
# request the session cookie is NOT marked Secure, so it travels where it can
# be read — and the browser refuses to register the service worker, which means
# the installable phone app and its offline drafts silently do not work at all.
# A certificate that exists but is not enforced buys neither of those things.
#
# The second condition covers shared hosting that terminates SSL at a proxy and
# forwards plain HTTP to PHP: without it the rule would loop for ever.
#
# IF THE SITE EVER APPEARS DOWN after a hosting change, put a # in front of the
# four lines below and it is immediately back — nothing else depends on them.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
