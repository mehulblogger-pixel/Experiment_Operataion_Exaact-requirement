# Copy to `.env` on your server and fill in real values, then:
#   docker compose up -d --build
#
# Keep this file secret — it contains passwords.

# --- Your domain (point its DNS A record at this server first) ---
DOMAIN=ops.yourcompany.com

# --- Django core ---
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=ops.yourcompany.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ops.yourcompany.com
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database (used by both the db and web containers) ---
POSTGRES_DB=inspexops
POSTGRES_USER=inspexops
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password

# --- First admin user (created automatically on first start) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourcompany.com
DJANGO_SUPERUSER_PASSWORD=CHANGE-ME-strong-admin-password

# --- Email (for reminders / digests). Leave unset to disable real sending. ---
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=ops@yourcompany.com
# EMAIL_HOST_PASSWORD=CHANGE-ME
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=operations@yourcompany.com

# --- Tuning (optional) ---
# GUNICORN_WORKERS=3
# SEED_ON_START=true
