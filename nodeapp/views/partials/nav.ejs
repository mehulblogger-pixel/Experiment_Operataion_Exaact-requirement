<header class="topbar">
  <a class="brand" href="/">Inspection&nbsp;Ops</a>
  <% if (currentUser) { %>
  <nav>
    <a href="/">Dashboard</a>
    <a href="/partners/clients">Clients</a>
    <a href="/partners/vendors">Vendors</a>
    <a href="/ops/calls">Calls</a>
    <% if (currentUser.canManageUsers()) { %><a href="/team/users">Users</a><% } %>
  </nav>
  <span class="user">
    <%= currentUser.fullName() %> · <%= currentUser.roleLabel() %>
    <form method="post" action="/logout" style="display:inline">
      <button class="logout" type="submit">Logout</button>
    </form>
  </span>
  <% } %>
</header>
<main class="container">
  <% (messages || []).forEach(function(m){ %>
    <div class="msg msg-<%= m.tag %>"><%= m.text %></div>
  <% }); %>
