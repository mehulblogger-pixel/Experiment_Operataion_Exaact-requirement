<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="master-head">
  <div>
    <h1><%= po.poNumber || 'Open Order' %></h1>
    <p class="sub"><%= po.partner ? po.partner.name() : '' %> · <%= choices.PO_TYPES[po.poType]||po.poType %><% if (po.value) { %> · ₹<%= po.value %><% } %></p>
  </div>
  <a class="btn secondary" href="/partners/<%= po.partnerId %>?tab=purchase_orders">← Back</a>
</div>

<h2>Line items</h2>
<table class="grid">
  <tr><th>Description</th><th>Type</th><th>Quantity</th><th>Consumed</th><th>Balance</th><th>Rate</th><th>Amount</th></tr>
  <% (po.lineItems||[]).forEach(function(li){ const bal=(Number(li.quantity)||0)-(Number(li.consumed)||0); const amt=li.rate!=null?(Number(li.quantity)||0)*Number(li.rate):null; %>
  <tr><td><%= li.description %></td><td><%= choices.PO_ITEM_TYPES[li.itemType]||li.itemType %></td><td><%= li.quantity %></td><td><%= li.consumed %></td><td><strong><%= bal %></strong></td><td><%= li.rate!=null?('₹'+li.rate):'—' %></td><td><%= amt!=null?('₹'+amt):'—' %></td></tr>
  <% }); %>
  <% if (!(po.lineItems||[]).length) { %><tr><td colspan="7">No line items yet.</td></tr><% } %>
</table>

<h3 class="tab-sub">Add line item</h3>
<form method="post" action="/partners/po/<%= po.id %>/item" class="inline-add">
  <div class="ff"><label>Description</label><input class="form-control" name="description" required></div>
  <div class="ff"><label>Type</label><select class="form-control" name="itemType"><% Object.keys(choices.PO_ITEM_TYPES).forEach(function(k){ %><option value="<%= k %>"><%= choices.PO_ITEM_TYPES[k] %></option><% }); %></select></div>
  <div class="ff"><label>Quantity</label><input class="form-control" type="number" step="0.01" name="quantity"></div>
  <div class="ff"><label>Rate</label><input class="form-control" type="number" step="0.01" name="rate"></div>
  <div class="ff"><label>Consumed</label><input class="form-control" type="number" step="0.01" name="consumed"></div>
  <button class="btn small" type="submit">Add line item</button>
</form>
<%- include('../partials/foot') %>
