<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<% const isClient = roleField === 'isClient'; %>
<div class="master-head">
  <div>
    <h1><%= title %></h1>
    <p class="sub"><%= subtitle %> · <%= total %> record<%= total === 1 ? '' : 's' %></p>
  </div>
  <a class="btn" href="/partners/new?role=<%= roleField %>">+ Add <%= isClient ? 'Client' : 'Vendor' %></a>
</div>

<form method="get" class="filter-bar">
  <input class="form-control" type="text" name="q" value="<%= q %>" placeholder="Search name / code / GSTIN / PAN…">
  <select class="form-control" name="status" onchange="this.form.submit()">
    <option value="">Any status</option>
    <% Object.keys(choices.STATUSES).forEach(function(k){ %>
      <option value="<%= k %>" <%= status===k?'selected':'' %>><%= choices.STATUSES[k] %></option>
    <% }); %>
  </select>
  <button class="btn secondary" type="submit">Search</button>
  <% if (q || status) { %><a class="btn secondary" href="?">Clear</a><% } %>
</form>

<table class="grid">
  <tr><th>Code</th><th>Name</th><th>Roles</th><th>Industry</th><th>GSTIN</th><th>Status</th></tr>
  <% rows.forEach(function(p){ %>
  <tr>
    <td><a href="/partners/<%= p.id %>"><%= p.code %></a></td>
    <td><a href="/partners/<%= p.id %>"><%= p.name() %></a><% if (p.parent) { %> <span class="muted">↳ <%= p.parent.name() %></span><% } %></td>
    <td><%= p.rolesLabel() %></td>
    <td><%= choices.INDUSTRIES[p.industry] || '—' %></td>
    <td><%= p.gstin || '—' %></td>
    <td><span class="badge <%= p.status==='ACTIVE'?'GREEN':(p.status==='BLACKLISTED'?'RED':'AMBER') %>"><%= choices.STATUSES[p.status]||p.status %></span></td>
  </tr>
  <% }); %>
  <% if (!rows.length) { %><tr><td colspan="6">No records found. <a href="/partners/new?role=<%= roleField %>">Add one</a>.</td></tr><% } %>
</table>

<% if (pages > 1) { %>
<div class="pill-row" style="margin-top:14px;align-items:center;">
  <% if (page > 1) { %><a class="btn small secondary" href="?q=<%= encodeURIComponent(q) %>&status=<%= status %>&page=<%= page-1 %>">← Prev</a><% } %>
  <span class="muted">Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a class="btn small secondary" href="?q=<%= encodeURIComponent(q) %>&status=<%= status %>&page=<%= page+1 %>">Next →</a><% } %>
</div>
<% } %>
<%- include('../partials/foot') %>
