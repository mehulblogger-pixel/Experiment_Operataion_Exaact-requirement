<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<% function fmtDate(d){ if(!d) return '—'; try { return new Date(d).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}); } catch(e){ return d; } } %>
<% const badge = p.status==='ACTIVE'?'GREEN':(p.status==='BLACKLISTED'?'RED':'AMBER'); %>

<div class="master-head">
  <div>
    <h1><%= p.name() %></h1>
    <p class="sub"><%= p.code %> · <%= p.rolesLabel() %> <span class="badge <%= badge %>"><%= choices.STATUSES[p.status]||p.status %></span></p>
  </div>
  <a class="btn secondary" href="/partners/<%= p.id %>/edit">Edit</a>
</div>

<% const tabs = [['overview','Overview'],['general','General'],['registration','Registration'],['addresses','Addresses'],['contacts','Contacts'],['contracts','Contract Numbers'],['purchase_orders','Purchase Orders'],['projects','Projects'],['relationships','Relationships'],['notes','Notes'],['timeline','Timeline']]; %>
<div class="tabs">
  <% tabs.forEach(function(t){ %><a href="?tab=<%= t[0] %>" class="<%= tab===t[0]?'active':'' %>"><%= t[1] %></a><% }); %>
</div>

<div class="panel tab-body">
<% if (tab === 'overview') { %>
  <dl class="kv">
    <dt>Roles</dt><dd><%= p.rolesLabel() %></dd>
    <dt>Client type</dt><dd><%= choices.CLIENT_TYPES[p.clientType] || '—' %></dd>
    <dt>Industry</dt><dd><%= choices.INDUSTRIES[p.industry] || '—' %></dd>
    <dt>Ownership</dt><dd><%= choices.OWNERSHIP[p.ownershipType] || '—' %></dd>
    <dt>GSTIN</dt><dd><%= p.gstin || '—' %><% if (p.state) { %> <span class="muted">(<%= p.state %>)</span><% } %></dd>
    <dt>PAN</dt><dd><%= p.pan || '—' %></dd>
    <dt>CIN</dt><dd><%= p.cin || '—' %></dd>
    <dt>Website</dt><dd><% if (p.website) { %><a href="<%= p.website %>" target="_blank" rel="noopener"><%= p.website %></a><% } else { %>—<% } %></dd>
    <dt>Description</dt><dd><%= p.description || '—' %></dd>
  </dl>
  <h3 class="tab-sub">Company hierarchy</h3>
  <div class="hierarchy">
    <div>🏢 <strong><%= p.parent ? p.parent.name() : p.name() %></strong><% if (p.parent) { %> <span class="muted">(parent)</span><% } %></div>
    <% (p.subsidiaries||[]).forEach(function(s){ %><div class="child">↳ <%= s.name() %> <span class="muted">(<%= s.code %>)</span></div><% }); %>
    <% if (!(p.subsidiaries||[]).length) { %><div class="child muted">No subsidiaries linked.</div><% } %>
  </div>

<% } else if (tab === 'general') { %>
  <dl class="kv">
    <dt>Legal name</dt><dd><%= p.legalName %></dd>
    <dt>Display name</dt><dd><%= p.displayName || '—' %></dd>
    <dt>Client code</dt><dd><%= p.code %></dd>
    <dt>Roles</dt><dd><%= p.rolesLabel() %></dd>
    <dt>GSTIN / PAN / CIN</dt><dd><%= p.gstin||'—' %> · <%= p.pan||'—' %> · <%= p.cin||'—' %></dd>
    <dt>TAN / MSME</dt><dd><%= p.tan||'—' %> · <%= p.msmeUdyam||'—' %></dd>
  </dl>
  <a class="btn secondary" href="/partners/<%= p.id %>/edit">Edit details</a>

<% } else if (tab === 'registration') { %>
  <table class="grid"><tr><th>Document</th><th>Number</th><th>Valid till</th></tr>
    <% (p.registrations||[]).forEach(function(r){ %><tr><td><%= choices.REG_TYPES[r.docType]||r.docType %></td><td><%= r.number||'—' %></td><td><%= fmtDate(r.validTo) %></td></tr><% }); %>
    <% if (!(p.registrations||[]).length) { %><tr><td colspan="3">No registrations yet.</td></tr><% } %></table>
  <h3 class="tab-sub">Add registration</h3>
  <form method="post" action="/partners/<%= p.id %>/registration" class="inline-add">
    <div class="ff"><label>Document</label><select class="form-control" name="docType"><% Object.keys(choices.REG_TYPES).forEach(function(k){ %><option value="<%= k %>"><%= choices.REG_TYPES[k] %></option><% }); %></select></div>
    <div class="ff"><label>Number</label><input class="form-control" name="number"></div>
    <div class="ff"><label>Valid till</label><input class="form-control" type="date" name="validTo"></div>
    <div class="ff"><label>Notes</label><input class="form-control" name="notes"></div>
    <button class="btn small" type="submit">Add</button>
  </form>

<% } else if (tab === 'addresses') { %>
  <% (p.addresses||[]).forEach(function(a){ %>
    <div class="addr-card"><div><span class="badge GREEN"><%= choices.ADDRESS_TYPES[a.addressType]||a.addressType %></span> <strong><%= a.label %></strong></div>
    <div class="muted"><%= [a.line1,a.line2,a.city,a.state,a.pincode].filter(Boolean).join(', ') %></div></div>
  <% }); %>
  <% if (!(p.addresses||[]).length) { %><p>No addresses yet.</p><% } %>
  <h3 class="tab-sub">Add an address</h3>
  <form method="post" action="/partners/<%= p.id %>/address" class="inline-add">
    <div class="ff"><label>Type</label><select class="form-control" name="addressType"><% Object.keys(choices.ADDRESS_TYPES).forEach(function(k){ %><option value="<%= k %>"><%= choices.ADDRESS_TYPES[k] %></option><% }); %></select></div>
    <div class="ff"><label>Label</label><input class="form-control" name="label"></div>
    <div class="ff"><label>Address line</label><input class="form-control" name="line1"></div>
    <div class="ff"><label>City</label><input class="form-control" name="city"></div>
    <div class="ff"><label>State</label><input class="form-control" name="state"></div>
    <div class="ff"><label>Pincode</label><input class="form-control" name="pincode"></div>
    <button class="btn small" type="submit">Add Address</button>
  </form>

<% } else if (tab === 'contacts') { %>
  <table class="grid"><tr><th>Name</th><th>Designation</th><th>Mobile</th><th>Email</th></tr>
    <% (p.contacts||[]).forEach(function(c){ %><tr><td><%= c.name %></td><td><%= c.designation||'—' %></td><td><%= c.mobile||'—' %></td><td><%= c.email||'—' %></td></tr><% }); %>
    <% if (!(p.contacts||[]).length) { %><tr><td colspan="4">No contacts yet.</td></tr><% } %></table>
  <h3 class="tab-sub">Add a contact</h3>
  <form method="post" action="/partners/<%= p.id %>/contact" class="inline-add">
    <div class="ff"><label>Name</label><input class="form-control" name="name" required></div>
    <div class="ff"><label>Designation</label><input class="form-control" name="designation"></div>
    <div class="ff"><label>Mobile</label><input class="form-control" name="mobile"></div>
    <div class="ff"><label>Email</label><input class="form-control" name="email"></div>
    <button class="btn small" type="submit">Add Contact</button>
  </form>

<% } else if (tab === 'contracts') { %>
  <table class="grid"><tr><th>Contract No.</th><th>Title</th><th>Value</th><th>Start</th><th>End</th></tr>
    <% (p.contracts||[]).forEach(function(c){ %><tr><td><%= c.contractNumber %></td><td><%= c.title||'—' %></td><td><%= c.value?('₹'+c.value):'—' %></td><td><%= fmtDate(c.startDate) %></td><td><%= fmtDate(c.endDate) %></td></tr><% }); %>
    <% if (!(p.contracts||[]).length) { %><tr><td colspan="5">No contracts yet.</td></tr><% } %></table>
  <h3 class="tab-sub">Add a contract</h3>
  <form method="post" action="/partners/<%= p.id %>/contract" class="inline-add">
    <div class="ff"><label>Contract number</label><input class="form-control" name="contractNumber" required></div>
    <div class="ff"><label>Title</label><input class="form-control" name="title"></div>
    <div class="ff"><label>Value</label><input class="form-control" name="value" type="number"></div>
    <div class="ff"><label>Start date</label><input class="form-control" type="date" name="startDate"></div>
    <button class="btn small" type="submit">Add Contract</button>
  </form>

<% } else if (tab === 'purchase_orders') { %>
  <table class="grid"><tr><th>PO No.</th><th>Type</th><th>Title</th><th>Value</th><th>Line items</th></tr>
    <% (p.purchaseOrders||[]).forEach(function(o){ %><tr><td><a href="/partners/po/<%= o.id %>"><%= o.poNumber||'(open)' %></a></td><td><%= choices.PO_TYPES[o.poType]||o.poType %></td><td><%= o.title||'—' %></td><td><%= o.value?('₹'+o.value):'—' %></td><td><%= (o.lineItems||[]).length %></td></tr><% }); %>
    <% if (!(p.purchaseOrders||[]).length) { %><tr><td colspan="5">No purchase orders yet.</td></tr><% } %></table>
  <h3 class="tab-sub">Add a purchase order</h3>
  <p class="muted">For open / ARC orders, save the PO then add line items (days, months, audit days).</p>
  <form method="post" action="/partners/<%= p.id %>/po" class="inline-add">
    <div class="ff"><label>PO number</label><input class="form-control" name="poNumber"></div>
    <div class="ff"><label>Type</label><select class="form-control" name="poType"><% Object.keys(choices.PO_TYPES).forEach(function(k){ %><option value="<%= k %>"><%= choices.PO_TYPES[k] %></option><% }); %></select></div>
    <div class="ff"><label>Title</label><input class="form-control" name="title"></div>
    <div class="ff"><label>Value</label><input class="form-control" name="value" type="number"></div>
    <button class="btn small" type="submit">Add PO</button>
  </form>

<% } else if (tab === 'projects') { %>
  <p class="muted">Inspection calls linked to this partner will appear here once the Operations module is ported (next stage).</p>

<% } else if (tab === 'relationships') { %>
  <table class="grid"><tr><th>This company…</th><th>Related company</th><th>Notes</th></tr>
    <% (p.relationships||[]).forEach(function(r){ %><tr><td><%= choices.REL_TYPES[r.relationType]||r.relationType %></td><td><% if (r.related) { %><a href="/partners/<%= r.related.id %>"><%= r.related.name() %></a><% } else { %>—<% } %></td><td><%= r.notes||'—' %></td></tr><% }); %>
    <% if (!(p.relationships||[]).length) { %><tr><td colspan="3">No relationships recorded.</td></tr><% } %></table>
  <h3 class="tab-sub">Add a relationship</h3>
  <form method="post" action="/partners/<%= p.id %>/relationship" class="inline-add">
    <div class="ff"><label>Relation</label><select class="form-control" name="relationType"><% Object.keys(choices.REL_TYPES).forEach(function(k){ %><option value="<%= k %>"><%= choices.REL_TYPES[k] %></option><% }); %></select></div>
    <div class="ff"><label>Related company ID</label><input class="form-control" name="relatedId" placeholder="numeric id from the other partner's URL"></div>
    <div class="ff"><label>Notes</label><input class="form-control" name="notes"></div>
    <button class="btn small" type="submit">Add</button>
  </form>

<% } else if (tab === 'notes') { %>
  <% (p.notes||[]).forEach(function(n){ %><div class="note-item"><div class="muted"><%= fmtDate(n.createdAt) %> · <%= n.authorName||'—' %></div><%= n.note %></div><% }); %>
  <% if (!(p.notes||[]).length) { %><p>No notes yet.</p><% } %>
  <h3 class="tab-sub">Add a note</h3>
  <form method="post" action="/partners/<%= p.id %>/note" class="inline-add">
    <div class="ff ff-wide"><label>Note</label><input class="form-control" name="note" required></div>
    <button class="btn small" type="submit">Add Note</button>
  </form>

<% } else if (tab === 'timeline') { %>
  <div class="timeline">
    <% timeline.forEach(function(e){ %><div class="tl-item"><span class="tl-icon"><%= e.icon %></span><span class="tl-date"><%= fmtDate(e.date) %></span><span class="tl-text"><%= e.text %></span></div><% }); %>
    <% if (!timeline.length) { %><p>No activity yet.</p><% } %>
  </div>
<% } %>
</div>
<%- include('../partials/foot') %>
