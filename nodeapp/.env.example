# Copy to `.env`. In development, leave DB_* unset to use a local SQLite file.

# --- Session ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- First admin (created automatically on first start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_EMAIL=admin@mghaiapps.com

# --- MySQL (from MilesWeb panel -> Databases). Leave unset for local SQLite. ---
# DB_NAME=yourpanel_inspexops
# DB_USER=yourpanel_inspex
# DB_PASS=your-db-password
# DB_HOST=localhost
# DB_PORT=3306

# PORT is provided automatically by the MilesWeb Node.js app manager.
