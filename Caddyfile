# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# {$DOMAIN} is read from the DOMAIN variable in your .env file.

{$DOMAIN} {
    # Serve uploaded report files directly from the shared media volume.
    handle_path /media/* {
        root * /srv/media
        file_server
    }

    # Everything else goes to the Django app (gunicorn).
    reverse_proxy web:8000

    encode gzip
}
